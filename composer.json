{
    "name": "ianfoxdev/webhook-outbox",
    "description": "Webhooks queued in your database transaction and delivered by a separate relay, signed per Standard Webhooks.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "webhooks",
        "standard-webhooks",
        "outbox",
        "transactional-outbox",
        "postgresql"
    ],
    "homepage": "https://github.com/IanFoxDev/webhook-outbox",
    "authors": [
        {
            "name": "Anatoly Pankratyev",
            "email": "ianfoxdeveloper@gmail.com"
        }
    ],
    "support": {
        "issues": "https://github.com/IanFoxDev/webhook-outbox/issues",
        "source": "https://github.com/IanFoxDev/webhook-outbox"
    },
    "require": {
        "php": "^8.3",
        "ext-json": "*"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^12.5 || ^13.0"
    },
    "suggest": {
        "ext-pdo_pgsql": "to queue webhooks with WebhookOutbox"
    },
    "autoload": {
        "psr-4": {
            "IanFoxDev\\WebhookOutbox\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "IanFoxDev\\WebhookOutbox\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
